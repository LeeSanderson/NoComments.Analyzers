<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Opinionated.DotNet.CodingStandards" Version="0.0.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately pinned: Roslyn 4.14 ships with VS 17.14 / SDK 9.0.3xx, the lowest supported host (avoids CS9057). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
